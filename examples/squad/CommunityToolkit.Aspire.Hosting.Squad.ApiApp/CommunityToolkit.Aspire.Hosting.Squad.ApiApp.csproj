    <PackageReference Include="Microsoft.Agents.AI.GitHub.Copilot" />
    <PackageReference Include="GitHub.Copilot.SDK" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../CommunityToolkit.Aspire.Hosting.Squad.ServiceDefaults/CommunityToolkit.Aspire.Hosting.Squad.ServiceDefaults.csproj" />
  </ItemGroup>

