<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AdditionalPackageTags>hosting bitwarden secrets secret-manager</AdditionalPackageTags>
    <Description>An Aspire hosting integration for Bitwarden Secrets Manager.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Bitwarden uses the public parameter APIs introduced in Aspire 17.0.0. -->
    <PackageReference Include="Aspire.Hosting" VersionOverride="17.0.0" />
    <PackageReference Include="Bitwarden.Secrets.Sdk" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.15" />
    <PackageReference Include="Polly" />
  </ItemGroup>

</Project>
