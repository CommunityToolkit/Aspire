<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AdditionalPackageTags>hosting Rust Bacon</AdditionalPackageTags>
    <Description>An Aspire integration for running Rust applications with Bacon.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CommunityToolkit.Aspire.Hosting.Rust.Tests"></InternalsVisibleTo>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SharedDir)\PathNormalizer.cs" Link="Utils\PathNormalizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.Rust" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.15" />
  </ItemGroup>

</Project>
