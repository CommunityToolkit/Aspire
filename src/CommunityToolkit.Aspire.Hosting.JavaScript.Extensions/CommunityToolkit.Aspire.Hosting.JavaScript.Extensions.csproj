<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AdditionalPackageTags>hosting nodejs vite yarn pnpm npm</AdditionalPackageTags>
    <Description>An Aspire integration for hosting NodeJS apps using Vite, Yarn, PNPM, or NPM.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" VersionOverride="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(SharedDir)\PathNormalizer.cs" Link="Utils\PathNormalizer.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="api/" />
  </ItemGroup>

</Project>
